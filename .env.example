# ---- LLM ----
# Which provider the pipeline tries first: gemini | groq
LLM_PROVIDER=gemini

# Free key from https://aistudio.google.com (required when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
# Model id. Flash-Lite is the default because full Flash models allow only 20 requests/day on the free tier.
GEMINI_MODEL=gemini-3.5-flash-lite
# Client-side limits, kept below the free tier's 15 requests/min and 250K tokens/min.
GEMINI_RPM=12
GEMINI_TPM=200000

# Free key from https://console.groq.com. Required when LLM_PROVIDER=groq. Otherwise optional: when set,
# Groq takes over if Gemini's daily quota runs out or Gemini fails.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Groq's free tier allows 30 requests/min but only 8K tokens/min.
GROQ_RPM=25
GROQ_TPM=7000

# Per-call timeout in milliseconds.
LLM_TIMEOUT_MS=60000
# Development only: directory for a record/replay cache of model answers. Leave empty to disable.
LLM_REPLAY_CACHE=

# ---- Retrieval ----
# Whether company URLs may be loopback or private addresses (e.g. http://localhost:8099/acme/).
# Empty means: allowed unless NODE_ENV=production. Set true or false to force it.
ALLOW_PRIVATE_URLS=

# ---- HTTP API ----
PORT=4000
# MongoDB connection string (Atlas free tier works) and database name.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=interview_prep_kit
# Signs session cookies. In production this must be a random value of at least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_DAYS=7
# Register and sign-in attempts allowed per address per 15 minutes.
AUTH_ATTEMPTS_PER_WINDOW=30
# The browser origin allowed to call the API with credentials (the deployed frontend's URL).
FRONTEND_ORIGIN=http://localhost:3000
# development | production. In production: secure cookies, private addresses refused, JWT_SECRET enforced.
NODE_ENV=development

# ---- Batch command ----
# Cases run at once, and how long one case may take before it is recorded as TIMEOUT.
BATCH_CONCURRENCY=2
CASE_TIMEOUT_MS=170000

# LLM_PROVIDER=offline runs a mechanical stand-in for the model (no key, no quota). Local development
# and interface tests only; refused when NODE_ENV=production. `npm run dev:offline` uses it together
# with an in-memory MongoDB and the fixture company sites.
