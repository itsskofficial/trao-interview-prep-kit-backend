# ---- LLM ----
# Which provider the pipeline tries first: gemini | groq
LLM_PROVIDER=gemini

# Free key from https://aistudio.google.com (required when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
# Model id. Flash-Lite is the default because full Flash models allow only 20 requests/day on the free tier.
GEMINI_MODEL=gemini-3.5-flash-lite
# Client-side limits, kept below the free tier's 15 requests/min and 250K tokens/min.
GEMINI_RPM=12
GEMINI_TPM=200000

# Free key from https://console.groq.com. Required when LLM_PROVIDER=groq. Otherwise optional: when set,
# Groq takes over if Gemini's daily quota runs out or Gemini fails.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Groq's free tier allows 30 requests/min but only 8K tokens/min.
GROQ_RPM=25
GROQ_TPM=7000

# Per-call timeout in milliseconds.
LLM_TIMEOUT_MS=60000
# Development only: directory for a record/replay cache of model answers. Leave empty to disable.
LLM_REPLAY_CACHE=

# ---- Retrieval ----
# Whether company URLs may be loopback or private addresses (e.g. http://localhost:8099/acme/).
# Empty means: allowed unless NODE_ENV=production. Set true or false to force it.
ALLOW_PRIVATE_URLS=

# ---- Batch command ----
# Cases run at once, and how long one case may take before it is recorded as TIMEOUT.
BATCH_CONCURRENCY=2
CASE_TIMEOUT_MS=170000
